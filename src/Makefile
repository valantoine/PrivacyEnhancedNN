CFLAGS= -std=c11 -Wall -Wextra -Werror -Wpedantic -g -MMD -O3 -lm -ffast-math
CPPFLAGS=-I../include -DDEBUG 
LDFLAGS=-lm


BINDIR = ../

src = $(wildcard *.c)
obj = $(src:.c=.o)
dep = $(obj:.o=.d)

all: neuralnetwork

neuralnetwork: $(obj)
	@$(CC) $(CFLAGS) -o $(BINDIR)/$@ $^ $(LDFLAGS)

-include $(dep)

clean:
	@rm -f $(obj) $(dep) $(BINDIR)/.neuralnetwork

help:
	@echo "Usage:"
	@echo "make [all]\t\tBuild the executable file"
	@echo "make clean\t\tRemove all files generated by make"
	@echo "make help\t\tDisplay this help"

.SILENT:

.PHONY:all clean help